generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMINISTRADOR
  DESENVOLVEDOR
  GESTOR
  COMERCIAL
  OPERACIONAL
}

enum Porte {
  MICRO
  PEQUENO
  MEDIO
  GRANDE
  ENTERPRISE
}

enum OrigemCliente {
  INDICACAO
  SITE
  REDES_SOCIAIS
  GOOGLE_ADS
  EVENTO
  LIGACAO_ATIVA
  PARCEIRO
  WHATSAPP
  OUTROS
}

enum EstagioLead {
  NOVO_LEAD
  CONTATO_INICIAL
  PRIMEIRO_ORCAMENTO
  QUALIFICACAO
  PROPOSTA_ENVIADA
  NEGOCIACAO
  FECHADO_GANHO
  FECHADO_PERDIDO
  REENGAJAR
}

enum Temperatura {
  QUENTE
  MORNO
  FRIO
}

enum StatusOportunidade {
  ABERTA
  GANHA
  PERDIDA
  SUSPENSA
}

enum TipoTarefa {
  REUNIAO
  LIGACAO
  VISITA
  FOLLOW_UP
  EMAIL
  TAREFA
  NOTIFICACAO
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  ATRASADA
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum TipoAtividade {
  CRIACAO
  EDICAO
  ESTAGIO_ALTERADO
  COMENTARIO
  TAREFA_CRIADA
  TAREFA_CONCLUIDA
  LIGACAO
  EMAIL
  REUNIAO
  ANEXO_ADICIONADO
}

enum TipoNotificacao {
  LEAD_NOVO
  TAREFA_VENCENDO
  OPORTUNIDADE_PARADA
  CLIENTE_SEM_CONTATO
  ORCAMENTO_PENDENTE
  SISTEMA
  WHATSAPP_MENSAGEM
}

enum StatusOrcamentoCliente {
  PENDENTE
  APROVADO
  NAO_APROVADO
}

enum StatusPosVenda {
  AGUARDANDO_VIDRO
  VIDRO_CHEGOU
  AGENDADO
  CONCLUIDO
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senha        String
  role         Role      @default(COMERCIAL)
  avatar       String?
  ativo        Boolean   @default(true)
  // Acesso ao módulo Financeiro é controlado por pessoa, não por cargo — Admin/Dev
  // sempre têm acesso (ver canAccessFinanceiro em src/lib/rbac.ts); os demais só se
  // esse campo estiver true. Liberado manualmente na tela de Usuários.
  acessoFinanceiro Boolean @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prefsNotificacao Json?

  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  vendas        Venda[]
  tarefas       Tarefa[]
  atividades    Atividade[]
  comentarios   Comentario[]
  notificacoes  Notificacao[]
  auditLogs     AuditLog[]

  chatMensagensEnviadas  ChatMensagem[] @relation("ChatMensagensEnviadas")
  chatMensagensRecebidas ChatMensagem[] @relation("ChatMensagensRecebidas")
  chatLeitura            ChatLeitura?
  alertasRecebidos       Alerta[]       @relation("AlertasRecebidos")
  alertasCriados         Alerta[]       @relation("AlertasCriados")
  alertasLeituras        AlertaLeitura[]
  whatsappSessoes        WhatsAppSessao[]    @relation("WhatsAppAtendente")
  whatsappConversas      WhatsAppConversa[]  @relation("WhatsAppResponsavel")
  financeiroLancamentos  FinanceiroLancamento[]
  financeiroCarroUsos    FinanceiroCarroUso[]

  // Financeiro novo (tabelas fin_*)
  finMemberships   WorkspaceMember[]
  finNotifications Notification[]
  finAuditLogs     FinAuditLog[]
  finAttachments   Attachment[]

  @@map("users")
}

model Empresa {
  id           String    @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?   @unique
  segmento     String?
  porte        Porte     @default(PEQUENO)
  website      String?
  telefone     String?
  email        String?
  cep          String?
  logradouro   String?
  numero       String?
  bairro       String?
  cidade       String?
  estado       String?
  observacoes  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contatos      Contato[]
  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  atividades    Atividade[]

  @@map("empresas")
}

model Contato {
  id          String    @id @default(cuid())
  nome        String
  cargo       String?
  email       String?
  telefone    String?
  whatsapp    String?
  cpf         String?
  avatar      String?
  principal   Boolean   @default(false)
  observacoes String?
  empresaId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  atividades    Atividade[]
  comentarios   Comentario[]

  @@map("contatos")
}

model Cliente {
  id            String        @id @default(cuid())
  nome          String
  razaoSocial   String?
  nomeFantasia  String?
  cpfCnpj       String?
  telefone      String?
  whatsapp      String?
  email         String?
  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  tipoResidencia String?
  bairro        String?
  cidade        String?
  estado        String?
  segmento        String?
  porte           Porte?
  origem          OrigemCliente          @default(OUTROS)
  responsavelId   String?
  empresaId       String?
  contatoId       String?
  observacoes     String?
  // Campos do fluxo de atendimento
  dataInscricao   DateTime?
  servicoBuscado  String?
  numeroOrcamento String?
  valorOrcamento      Decimal?               @db.Decimal(15, 2)
  prazoOrcamento      DateTime?
  dataVenda           DateTime?
  statusOrcamento     StatusOrcamentoCliente @default(PENDENTE)
  orcamentoEnviadoEm      DateTime?
  orcamentoFinalNumero    String?
  orcamentoFinalValor     Decimal?  @db.Decimal(15, 2)
  orcamentoFinalEm        DateTime?
  revisadoEm              DateTime?
  notificacaoMensagem     String?
  notificacaoEm           DateTime?
  notificacaoLida         Boolean   @default(false)
  notificacaoResposta     String?
  notificacaoRespondidaEm DateTime?
  temperatura     Temperatura            @default(MORNO)
  motivoExclusao  String?
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  responsavel   User?         @relation(fields: [responsavelId], references: [id])
  empresa       Empresa?      @relation(fields: [empresaId], references: [id])
  contato       Contato?      @relation(fields: [contatoId], references: [id])
  leads         Lead[]
  oportunidades Oportunidade[]
  vendas        Venda[]
  tarefas       Tarefa[]
  atividades    Atividade[]
  comentarios   Comentario[]
  anexos        Anexo[]

  @@map("clientes")
}

model Lead {
  id             String        @id @default(cuid())
  titulo         String
  descricao      String?
  estagio        EstagioLead   @default(NOVO_LEAD)
  ordemKanban    Int           @default(0)
  valorEstimado  Decimal?      @db.Decimal(15, 2)
  temperatura    Temperatura   @default(MORNO)
  origem         OrigemCliente @default(OUTROS)
  responsavelId  String?
  clienteId      String?
  empresaId      String?
  contatoId      String?
  dataFechamento DateTime?
  motivoPerda    String?
  proximoContato DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  responsavel   User?          @relation(fields: [responsavelId], references: [id])
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  contato       Contato?       @relation(fields: [contatoId], references: [id])
  oportunidades Oportunidade[]
  venda         Venda?
  tarefas       Tarefa[]
  atividades    Atividade[]
  comentarios   Comentario[]
  anexos        Anexo[]

  @@map("leads")
}

model Venda {
  id              String    @id @default(cuid())
  clienteId       String
  leadId          String?   @unique
  responsavelId   String?
  numeroOrcamento String
  valor           Decimal   @db.Decimal(15, 2)
  data            DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Acompanhamento pós-venda (aba "Confirmado")
  statusPosVenda      StatusPosVenda @default(AGUARDANDO_VIDRO)
  ordemKanban         Int            @default(0)
  vidroChegouEm       DateTime?
  dataAgendamento     DateTime?
  horarioAgendamento  String?
  observacoesPosVenda String?

  cliente     Cliente @relation(fields: [clienteId], references: [id])
  lead        Lead?   @relation(fields: [leadId], references: [id])
  responsavel User?   @relation(fields: [responsavelId], references: [id])

  @@map("vendas")
}

model Oportunidade {
  id             String             @id @default(cuid())
  titulo         String
  descricao      String?
  valor          Decimal            @db.Decimal(15, 2)
  probabilidade  Int                @default(50)
  status         StatusOportunidade @default(ABERTA)
  dataPrevisao   DateTime?
  dataFechamento DateTime?
  responsavelId  String?
  clienteId      String?
  empresaId      String?
  contatoId      String?
  leadId         String?
  motivoPerda    String?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  responsavel User?     @relation(fields: [responsavelId], references: [id])
  cliente     Cliente?  @relation(fields: [clienteId], references: [id])
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  contato     Contato?  @relation(fields: [contatoId], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])
  tarefas     Tarefa[]
  atividades  Atividade[]
  comentarios Comentario[]
  anexos      Anexo[]

  @@map("oportunidades")
}

model Tarefa {
  id             String       @id @default(cuid())
  titulo         String
  descricao      String?
  tipo           TipoTarefa   @default(TAREFA)
  status         StatusTarefa @default(PENDENTE)
  prioridade     Prioridade   @default(MEDIA)
  dataVencimento DateTime
  horario        String?
  dataInicio     DateTime?
  dataConclusao  DateTime?
  responsavelId  String?
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  responsavel  User?         @relation(fields: [responsavelId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  atividades   Atividade[]

  @@map("tarefas")
}

model Atividade {
  id             String        @id @default(cuid())
  tipo           TipoAtividade
  descricao      String
  userId         String
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  contatoId      String?
  empresaId      String?
  tarefaId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  contato      Contato?      @relation(fields: [contatoId], references: [id])
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  tarefa       Tarefa?       @relation(fields: [tarefaId], references: [id])

  @@map("atividades")
}

model Comentario {
  id             String    @id @default(cuid())
  texto          String
  userId         String
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  contatoId      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  contato      Contato?      @relation(fields: [contatoId], references: [id])

  @@map("comentarios")
}

model Anexo {
  id             String    @id @default(cuid())
  nome           String
  url            String
  tipo           String
  tamanho        Int
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])

  @@map("anexos")
}

model Notificacao {
  id        String          @id @default(cuid())
  titulo    String
  mensagem  String
  tipo      TipoNotificacao
  lida      Boolean         @default(false)
  userId    String
  linkUrl   String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notificacoes")
}

// ==========================================
// CHAT INTERNO (comunicação entre a equipe)
// ==========================================

model ChatMensagem {
  id             String    @id @default(cuid())
  conteudo       String
  autorId        String
  // null = mensagem do canal geral (visível a todos); preenchido = DM pro usuário
  destinatarioId String?
  lida           Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  autor        User  @relation("ChatMensagensEnviadas", fields: [autorId], references: [id])
  destinatario User? @relation("ChatMensagensRecebidas", fields: [destinatarioId], references: [id])

  @@index([destinatarioId])
  @@index([autorId])
  @@index([createdAt])
  @@map("chat_mensagens")
}

// Marca até quando cada usuário já leu o canal geral — usado só pra contar não lidas
// (mensagens diretas já têm o campo "lida" por mensagem, isso aqui é só pro canal geral).
model ChatLeitura {
  id          String   @id @default(cuid())
  userId      String   @unique
  ultimaGeral DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("chat_leituras")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  entidade    String
  entidadeId  String
  acao        String
  dadosAntigos Json?
  dadosNovos  Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// WHATSAPP — gateway self-hosted (Evolution API), ver docs/architecture/whatsapp.md
// ==========================================

enum WhatsAppProvider {
  EVOLUTION
  META
  WPPCONNECT
  GREEN_API
  UNKNOWN
}

enum WhatsAppSessaoStatus {
  ONLINE
  OFFLINE
  RECONNECTING
  WAITING_QR
  ERROR
  UNKNOWN
}

enum WhatsAppSessaoEvento {
  CONECTOU
  DESCONECTOU
  QR_GERADO
  QR_EXPIROU
  ERRO
  RECONECTOU
  REINICIOU
  ATUALIZOU
}

enum WhatsAppMensagemStatus {
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum WhatsAppConversaStatus {
  ABERTA
  PENDENTE
  RESOLVIDA
}

// Coluna do quadro de atendimento. Configurável pelo Dev/Admin (nome, cor,
// ordem, criar/excluir). WhatsAppConversa.etapa guarda o id desta linha
// (junção manual por string, no mesmo padrão de clienteId).
model WhatsAppEtapa {
  id                String   @id @default(cuid())
  nome              String
  cor               String   @default("#6366f1")
  ordem             Int
  sistema           Boolean  @default(false) // as 6 originais: renomear/reordenar sim, excluir não
  visivelParaCanais String[] @default([]) // ids de WhatsAppSessao (canais) liberados a ver a coluna no Quadro; vazio = todo mundo vê. Admin/Dev sempre veem, independente do canal selecionado.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("whatsapp_etapas")
}

// Envio agendado (ex: mensagem de boas-vindas com atraso de X minutos).
// Sem cron no projeto — processado de forma oportunista (webhook + polling
// da lista de conversas). Ver src/lib/whatsapp/envios-agendados.ts.
model WhatsAppEnvioAgendado {
  id                 String    @id @default(cuid())
  conversaId         String
  texto              String
  enviarEm           DateTime
  enviadoEm          DateTime?
  canceladoEm        DateTime?
  motivoCancelamento String?
  tentativas         Int       @default(0)
  processandoEm      DateTime?
  createdAt          DateTime  @default(now())

  @@index([enviadoEm, canceladoEm, enviarEm])
  @@map("whatsapp_envios_agendados")
}

// Mensagem pré-definida (chip de resposta rápida no composer da conversa).
// Compartilhada por todos os atendentes; editável por Admin/Dev.
model WhatsAppRespostaRapida {
  id        String   @id @default(cuid())
  texto     String
  ordem     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_respostas_rapidas")
}

enum WhatsAppGatilho {
  CONTATO_NOVO       // primeira mensagem de um número desconhecido
  MENSAGEM_RECEBIDA  // qualquer mensagem recebida (com filtro opcional de palavras)
  FORA_DO_HORARIO    // mensagem recebida fora do horário de atendimento
  CLIENTE_CADASTRADO // cliente criado no CRM com número de WhatsApp
}

// Regra de automação gatilho -> ações, executada pelo pipeline de eventos.
model WhatsAppAutomacao {
  id              String          @id @default(cuid())
  nome            String
  ativa           Boolean         @default(true)
  gatilho         WhatsAppGatilho
  // { palavras?: string[]; horario?: { inicio: string; fim: string; dias: number[] } }
  gatilhoConfig   Json?
  // [{ tipo: "ENVIAR_MENSAGEM"; texto: string } | { tipo: "MOVER_ETAPA"; etapa } | ...]
  acoes           Json
  sessaoId        String? // null = vale para todas as sessões
  disparos        Int             @default(0)
  ultimoDisparoEm DateTime?
  criadoPorId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ativa])
  @@map("whatsapp_automacoes")
}

model WhatsAppSessao {
  id                     String                @id @default(cuid())
  nome                   String
  numero                 String?
  provider               WhatsAppProvider      @default(EVOLUTION)
  providerVersion        String?
  providerSessionId      String                @unique
  status                 WhatsAppSessaoStatus  @default(UNKNOWN)
  ultimoPing             DateTime?
  ultimaMensagemRecebida DateTime?
  lastError              String?
  lastErrorAt            DateTime?
  atendenteId            String?
  empresaId              String?
  ativo                  Boolean               @default(true)
  historicoImportadoEm   DateTime? // quando a importação do histórico terminou
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  atendente User? @relation("WhatsAppAtendente", fields: [atendenteId], references: [id])
  conversas WhatsAppConversa[]
  logs      WhatsAppSessaoLog[]

  @@index([atendenteId])
  @@map("whatsapp_sessoes")
}

model WhatsAppSessaoLog {
  id        String               @id @default(cuid())
  sessaoId  String
  evento    WhatsAppSessaoEvento
  detalhe   String?
  createdAt DateTime             @default(now())

  sessao WhatsAppSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@map("whatsapp_sessao_logs")
}

// Dedup de entrega de webhook (idempotência) — ver docs/architecture/whatsapp.md
model WhatsAppWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  tipo            String
  recebidoEm      DateTime @default(now())

  @@map("whatsapp_webhook_events")
}

model WhatsAppConversa {
  id            String                 @id @default(cuid())
  sessaoId      String
  contatoPhone  String
  contatoNome   String?
  clienteId     String?
  status        WhatsAppConversaStatus @default(ABERTA)
  etapa         String                 @default("NOVA") // id de WhatsAppEtapa
  responsavelId String?
  tags          String[]               @default([])
  notaInterna   String?
  isGrupo       Boolean                @default(false)
  fotoUrl       String?                // URL da foto de perfil no WhatsApp (expira; re-sincronizada)
  fotoSyncEm    DateTime?
  ultimaMsgEm   DateTime?
  naoLidas      Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  // Restrict (não Cascade): excluir uma sessão nunca pode apagar histórico de
  // conversas junto — é por isso que essa arquitetura existe. "Excluir sessão"
  // na prática é soft-delete (WhatsAppSessao.ativo = false), então essa
  // restrição nunca deveria ser acionada em uso normal; existe como rede de
  // segurança contra um DELETE direto acidental na tabela de sessões.
  sessao      WhatsAppSessao       @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  responsavel User?                @relation("WhatsAppResponsavel", fields: [responsavelId], references: [id])
  mensagens   WhatsAppMensagem[]
  agentEstado WhatsAppAgentEstado?

  @@unique([sessaoId, contatoPhone])
  @@index([sessaoId])
  @@index([responsavelId])
  @@map("whatsapp_conversas")
}

model WhatsAppMensagem {
  id                String                  @id @default(cuid())
  conversaId        String
  providerMessageId String?                 @unique
  direcao           String   // 'entrada' | 'saida'
  tipo              String   @default("texto")
  conteudo          String
  remetenteNome     String?  // nome de quem enviou (só faz sentido em grupo)
  remetentePhone    String?  // telefone de quem enviou dentro do grupo
  mediaUrl          String?
  status            WhatsAppMensagemStatus  @default(ENVIANDO)
  enviadaEm         DateTime @default(now())
  entregueEm        DateTime?
  lidaEm            DateTime?
  falhouEm          DateTime?

  conversa WhatsAppConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("whatsapp_mensagens")
}

// Estado do agente de IA de recepção — separado de WhatsAppConversa para não
// acoplar o modelo de conversa a campos específicos do agente.
model WhatsAppAgentEstado {
  id                  String         @id @default(cuid())
  conversaId          String         @unique
  estado              BotEstado      @default(TRIAGEM)
  nome                String?
  servico             String?
  cidade              String?
  urgente             Boolean        @default(false)
  resumo              String?
  tentativas          Int            @default(0)
  motivoTransferencia HandoffReason?
  agentVersion        String         @default("1.0")
  clienteId           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  conversa WhatsAppConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@map("whatsapp_agent_estados")
}

enum BotEstado {
  TRIAGEM
  COLETANDO
  AGUARDANDO_CONFIRMACAO
  CONCLUIDO
  HUMANO
}

enum HandoffReason {
  MUITAS_TENTATIVAS
  CLIENTE_PEDIU_HUMANO
  SERVICO_NAO_RECONHECIDO
}

model Alerta {
  id             String          @id @default(cuid())
  titulo         String
  mensagem       String
  criadoEm       DateTime        @default(now())
  destinoUserId  String?
  destinoUser    User?           @relation("AlertasRecebidos", fields: [destinoUserId], references: [id], onDelete: Cascade)
  criadorId      String
  criador        User            @relation("AlertasCriados", fields: [criadorId], references: [id], onDelete: Cascade)
  leituras       AlertaLeitura[]

  @@map("alertas")
}

model AlertaLeitura {
  id       String   @id @default(cuid())
  alertaId String
  alerta   Alerta   @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lidoEm   DateTime @default(now())

  @@unique([alertaId, userId])
  @@map("alertas_leituras")
}

// ── Financeiro ──────────────────────────────────────────────────────────
// Módulo separado do CRM (acesso controlado por User.acessoFinanceiro, ver
// canAccessFinanceiro em src/lib/rbac.ts). `origem` em Conta/Lancamento já
// deixa o desenho pronto pra fase 2 (sincronização automática via Open
// Finance/Pluggy) sem precisar migrar de novo — por enquanto só MANUAL é
// usado.
enum FinanceiroContaTipo {
  CAIXA
  CORRENTE
  POUPANCA
  INVESTIMENTO
  CARTAO
}

enum FinanceiroOrigem {
  MANUAL
  OPEN_FINANCE
}

enum FinanceiroTipoLancamento {
  ENTRADA
  SAIDA
}

model FinanceiroConta {
  id                  String              @id @default(cuid())
  nome                String
  tipo                FinanceiroContaTipo @default(CAIXA)
  origem              FinanceiroOrigem    @default(MANUAL)
  instituicao         String?
  saldoInicial        Decimal             @default(0) @db.Decimal(15, 2)
  cor                 String?
  ativa               Boolean             @default(true)
  // Preenchido só quando origem = OPEN_FINANCE (fase 2, integração Pluggy)
  pluggyItemId        String?
  pluggyAccountId     String?             @unique
  ultimaSincronizacao DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  lancamentos FinanceiroLancamento[]

  @@map("financeiro_contas")
}

model FinanceiroCategoria {
  id        String                   @id @default(cuid())
  nome      String
  tipo      FinanceiroTipoLancamento
  cor       String?
  padrao    Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  lancamentos FinanceiroLancamento[]

  @@unique([nome, tipo])
  @@map("financeiro_categorias")
}

model FinanceiroLancamento {
  id          String                   @id @default(cuid())
  contaId     String
  conta       FinanceiroConta          @relation(fields: [contaId], references: [id], onDelete: Restrict)
  categoriaId String?
  categoria   FinanceiroCategoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  tipo        FinanceiroTipoLancamento
  descricao   String
  valor       Decimal                  @db.Decimal(15, 2)
  data        DateTime
  origem      FinanceiroOrigem         @default(MANUAL)
  // Preenchido só quando origem = OPEN_FINANCE (fase 2)
  pluggyTransactionId String?          @unique
  criadoPorId String?
  criadoPor   User?                    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  carroUsoCombustivel FinanceiroCarroUso? @relation("CarroUsoCombustivel")

  @@index([contaId, data])
  @@index([categoriaId])
  @@map("financeiro_lancamentos")
}

// ── Carros (frota) ──────────────────────────────────────────────────────
// "Status" do carro (disponível/em uso) não fica salvo em coluna própria —
// é derivado em runtime pela existência de um FinanceiroCarroUso em aberto
// (chegadaEm null), evitando os dois ficarem dessincronizados.
model FinanceiroCarro {
  id        String   @id @default(cuid())
  numero    String
  modelo    String
  ano       Int
  placa     String   @unique
  cor       String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usos FinanceiroCarroUso[]

  @@map("financeiro_carros")
}

model FinanceiroMotorista {
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usos FinanceiroCarroUso[]

  @@map("financeiro_motoristas")
}

model FinanceiroCarroUso {
  id              String               @id @default(cuid())
  carroId         String
  carro           FinanceiroCarro      @relation(fields: [carroId], references: [id], onDelete: Restrict)
  motoristaId     String
  motorista       FinanceiroMotorista  @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  kmSaida         Int
  saidaEm         DateTime             @default(now())
  kmChegada       Int?
  chegadaEm       DateTime?
  observacoes     String?
  registradoPorId String?
  registradoPor   User?                @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Valor entregue ao motorista pra colocar gasolina na saída. Quando preenchido, gera
  // automaticamente um lançamento de saída no Caixa (categoria "Combustível") — ver
  // POST /api/financeiro/carros/usos.
  valorCombustivel        Decimal?              @db.Decimal(10, 2)
  lancamentoCombustivelId String?               @unique
  lancamentoCombustivel   FinanceiroLancamento? @relation("CarroUsoCombustivel", fields: [lancamentoCombustivelId], references: [id], onDelete: SetNull)

  // Financeiro novo: a despesa de gasolina fica em fin_transactions.car_use_id (só relação do
  // Prisma; esta tabela não ganha coluna).
  finTransaction Transaction? @relation("FinCarUseFuel")

  @@index([carroId, saidaEm])
  @@index([motoristaId])
  @@map("financeiro_carro_usos")
}

// ==========================================
// FINANCEIRO (sistema novo, portado de Financeiro/prisma/schema)
// ==========================================
// Tabelas com prefixo fin_ para não colidir com as do CRM. Não substituem as
// financeiro_* (Caixa e Carros), que continuam intactas até a migração da Fase 3.
// Login e usuários são os do CRM (model User); papel no workspace vem de
// canAccessFinanceiro. Convenções: Financeiro/docs/03-banco-de-dados.md.

// Gerador, datasource e enums compartilhados.
// Convenções: docs/03-banco-de-dados.md · Dinheiro em Decimal(14,2), datas de negócio em @db.Date.

enum WorkspaceKind {
  PERSONAL
  BUSINESS
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  CHECKING // conta corrente
  SAVINGS // poupança
  WALLET // dinheiro em espécie
  INVESTMENT // conta de investimento / corretora
  BENEFIT // vale-refeição / alimentação
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

/// Agrupa receitas no painel: Base · Comissões · Renda extra · Outros.
enum IncomeClass {
  BASE
  COMMISSION
  EXTRA
  OTHER
}

enum ExpenseNature {
  FIXED
  VARIABLE
}

enum TransactionType {
  INCOME // receita
  EXPENSE // despesa (em conta ou cartão)
  REFUND // estorno: abate despesa da mesma categoria
  TRANSFER // entre contas do workspace
  CARD_PAYMENT // pagamento de fatura (não é despesa; as compras já foram)
}

/// "Atrasado" não é gravado: é PENDING com vencimento < hoje.
enum TransactionStatus {
  PENDING // previsto / a pagar / a receber
  SETTLED // pago / recebido
  CANCELED
}

enum PaymentMethod {
  PIX
  DEBIT_CARD
  CREDIT_CARD
  BOLETO
  BANK_TRANSFER
  AUTO_DEBIT
  CASH
  BENEFIT_CARD
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceDayRule {
  FIXED_DAY // dia fixo (31 = último dia do mês)
  NTH_BUSINESS_DAY // ex.: 5º dia útil
  LAST_BUSINESS_DAY
}

/// O que fazer quando a data cai em fim de semana ou feriado.
enum BusinessDayShift {
  NONE
  NEXT
  PREVIOUS
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
}

enum InstallmentPlanStatus {
  ACTIVE
  FINISHED
  SETTLED_EARLY // quitação antecipada
  CANCELED
}

enum GoalKind {
  EMERGENCY_FUND
  SAVINGS
  PURCHASE
  INVESTMENT
  DEBT_PAYOFF
  OTHER
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED
}

enum AssetKind {
  INVESTMENT
  EQUIPMENT
  VEHICLE
  REAL_ESTATE
  OTHER
}

enum LiabilityKind {
  LOAN
  FINANCING
  PERSONAL_DEBT
  OTHER
}

/// Informação · Atenção · Importante · Crítico
enum NotificationPriority {
  INFO
  ATTENTION
  IMPORTANT
  CRITICAL
}

enum SnapshotPeriod {
  DAILY
  MONTHLY
}

enum ImportSource {
  CSV
  XLSX
  OFX
  OPEN_FINANCE
}

enum ImportStatus {
  DRAFT // em revisão, ainda não gerou lançamentos definitivos
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Tenancy: todo dado financeiro pertence a um workspace.

/// Tenant. Hoje: 1 usuário, 1 workspace pessoal (+ 1 de demonstração).
/// Amanhã: família, empresa (PJ), planos SaaS — sem migrar dados.
model Workspace {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String        @unique
  kind         WorkspaceKind @default(PERSONAL)
  isDemo       Boolean       @default(false) @map("is_demo")
  baseCurrency String        @default("BRL") @map("base_currency") @db.Char(3)
  timezone     String        @default("America/Sao_Paulo")
  locale       String        @default("pt-BR")
  /// Preferências não estruturais (horizonte de projeção, meses da média etc.).
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  members            WorkspaceMember[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  recurrences        Recurrence[]
  subscriptions      Subscription[]
  creditCards        CreditCard[]
  invoices           CreditCardInvoice[]
  installmentPlans   InstallmentPlan[]
  commissions        Commission[]
  budgets            Budget[]
  goals              Goal[]
  goalContributions  GoalContribution[]
  assets             Asset[]
  liabilities        Liability[]
  attachments        Attachment[]
  notifications      Notification[]
  financialSnapshots FinancialSnapshot[]
  importBatches      ImportBatch[]
  monthCloses        MonthClose[]
  auditLogs          FinAuditLog[]

  @@map("fin_workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id")
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("fin_workspace_members")
}

// Livro-caixa: contas, categorias, lançamentos, recorrências, assinaturas e comissões.

/// Conta bancária, carteira, poupança, corretora ou vale-benefício.
/// Saldo = saldo inicial + efeitos dos lançamentos liquidados (calculado).
model Account {
  id                 String      @id @default(uuid(7)) @db.Uuid
  workspaceId        String      @map("workspace_id") @db.Uuid
  name               String
  type               AccountType
  institution        String?
  currency           String      @default("BRL") @db.Char(3)
  initialBalance     Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  initialBalanceDate DateTime    @map("initial_balance_date") @db.Date
  /// Compõe o "saldo disponível" do painel.
  isLiquid           Boolean     @default(true) @map("is_liquid")
  includeInNetWorth  Boolean     @default(true) @map("include_in_net_worth")
  color              String?     @db.VarChar(7)
  icon               String?
  sortOrder          Int         @default(0) @map("sort_order")
  /// id da linha correspondente em financeiro_* (Caixa antigo): torna a cópia repetível.
  legacyId           String?     @map("legacy_id")
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]     @relation("TransactionAccount")
  incomingTransfers Transaction[]     @relation("TransactionTransferAccount")
  recurrences       Recurrence[]
  installmentPlans  InstallmentPlan[]
  cardsPaidFromHere CreditCard[]
  goals             Goal[]
  importBatches     ImportBatch[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, legacyId])
  @@map("fin_accounts")
}

/// Hierarquia de 2 níveis (ex.: Moradia → Aluguel, Condomínio, Energia).
model Category {
  id            String         @id @default(uuid(7)) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  parentId      String?        @map("parent_id") @db.Uuid
  kind          CategoryKind
  name          String
  /// Nome do ícone Lucide.
  icon          String
  color         String         @db.VarChar(7)
  incomeClass   IncomeClass?   @map("income_class")
  defaultNature ExpenseNature? @map("default_nature")
  /// Custo essencial: entra no cálculo de cobertura da reserva de emergência.
  isEssential   Boolean        @default(false) @map("is_essential")
  /// Categorias do sistema (não excluíveis): "commission", "card_fees", ...
  systemKey     String?        @map("system_key")
  sortOrder     Int            @default(0) @map("sort_order")
  /// id da linha correspondente em financeiro_* (Caixa antigo): torna a cópia repetível.
  legacyId      String?        @map("legacy_id")
  archivedAt    DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]
  recurrences      Recurrence[]
  installmentPlans InstallmentPlan[]
  budgets          Budget[]

  @@unique([workspaceId, systemKey])
  @@unique([workspaceId, legacyId])
  @@index([workspaceId, kind, sortOrder])
  @@map("fin_categories")
}

model Transaction {
  id          String            @id @default(uuid(7)) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String
  notes       String?
  /// Sempre > 0. O sinal vem do tipo.
  amount      Decimal           @db.Decimal(14, 2)

  /// Competência: data da compra / do fato gerador.
  date      DateTime  @db.Date
  /// Vencimento ou previsão de recebimento. Em compras no cartão = vencimento da fatura.
  dueDate   DateTime  @map("due_date") @db.Date
  /// Data efetiva do pagamento/recebimento.
  settledAt DateTime? @map("settled_at") @db.Date

  /// Conta de origem (despesa/transferência/pagamento de fatura) ou de destino (receita).
  accountId         String?        @map("account_id") @db.Uuid
  /// Destino de uma transferência.
  transferAccountId String?        @map("transfer_account_id") @db.Uuid
  creditCardId      String?        @map("credit_card_id") @db.Uuid
  /// Fatura onde a compra cai — ou fatura que um CARD_PAYMENT quita.
  invoiceId         String?        @map("invoice_id") @db.Uuid
  categoryId        String?        @map("category_id") @db.Uuid
  nature            ExpenseNature?
  paymentMethod     PaymentMethod? @map("payment_method")

  recurrenceId         String?   @map("recurrence_id") @db.Uuid
  /// Data "natural" da ocorrência (chave de idempotência da geração).
  recurrenceDate       DateTime? @map("recurrence_date") @db.Date
  /// Ocorrência editada à mão: alterações na regra não a sobrescrevem.
  isRecurrenceOverride Boolean   @default(false) @map("is_recurrence_override")
  installmentPlanId    String?   @map("installment_plan_id") @db.Uuid
  installmentNumber    Int?      @map("installment_number")
  refundOfId           String?   @map("refund_of_id") @db.Uuid
  /// Ajuste de conciliação de saldo: afeta o saldo, fica fora dos relatórios.
  isBalanceAdjustment  Boolean   @default(false) @map("is_balance_adjustment")

  importBatchId String? @map("import_batch_id") @db.Uuid
  /// FITID do OFX ou id do Open Finance (deduplicação de importações).
  externalId    String? @map("external_id")
  /// id da linha correspondente em financeiro_* (Caixa antigo): torna a cópia repetível.
  legacyId      String? @map("legacy_id")
  /// Uso de carro (financeiro_carro_usos) cuja gasolina gerou esta despesa.
  carUseId      String? @unique @map("car_use_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Lixeira: excluído pelo usuário, restaurável.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          Account?           @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: NoAction)
  transferAccount  Account?           @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: NoAction)
  creditCard       CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: NoAction)
  invoice          CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: NoAction)
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  recurrence       Recurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: NoAction)
  installmentPlan  InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id], onDelete: NoAction)
  refundOf         Transaction?       @relation("Refunds", fields: [refundOfId], references: [id], onDelete: NoAction)
  refunds          Transaction[]      @relation("Refunds")
  importBatch      ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: NoAction)
  commission       Commission?
  goalContribution GoalContribution?
  attachments      Attachment[]
  carUse           FinanceiroCarroUso? @relation("FinCarUseFuel", fields: [carUseId], references: [id], onDelete: SetNull)

  @@unique([recurrenceId, recurrenceDate])
  @@unique([installmentPlanId, installmentNumber])
  @@unique([accountId, externalId])
  @@unique([workspaceId, legacyId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, date])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, categoryId, date])
  @@index([accountId, settledAt])
  @@index([creditCardId, dueDate])
  @@index([invoiceId])
  @@map("fin_transactions")
}

/// Regra que gera lançamentos (salário, aluguel, assinaturas...).
/// As ocorrências são materializadas num horizonte móvel de 12 meses.
model Recurrence {
  id                  String              @id @default(uuid(7)) @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  /// Apenas INCOME ou EXPENSE (CHECK).
  type                TransactionType
  description         String
  amount              Decimal             @db.Decimal(14, 2)
  /// Valor varia a cada mês (ex.: energia): a previsão usa a média recente.
  isEstimatedAmount   Boolean             @default(false) @map("is_estimated_amount")
  categoryId          String?             @map("category_id") @db.Uuid
  accountId           String?             @map("account_id") @db.Uuid
  creditCardId        String?             @map("credit_card_id") @db.Uuid
  paymentMethod       PaymentMethod?      @map("payment_method")
  nature              ExpenseNature?
  frequency           RecurrenceFrequency
  intervalCount       Int                 @default(1) @map("interval_count")
  dayRule             RecurrenceDayRule   @default(FIXED_DAY) @map("day_rule")
  /// FIXED_DAY: 1–31 · NTH_BUSINESS_DAY: n-ésimo dia útil.
  dayOfMonth          Int?                @map("day_of_month")
  /// WEEKLY: 0 (domingo) – 6.
  weekday             Int?
  /// YEARLY: 1–12.
  monthOfYear         Int?                @map("month_of_year")
  nonBusinessDayShift BusinessDayShift    @default(NONE) @map("non_business_day_shift")
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime?           @map("end_date") @db.Date
  maxOccurrences      Int?                @map("max_occurrences")
  /// Até onde as ocorrências já foram materializadas.
  generatedUntil      DateTime?           @map("generated_until") @db.Date
  pausedAt            DateTime?           @map("paused_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: NoAction)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: NoAction)
  transactions Transaction[]
  subscription Subscription?

  @@index([workspaceId, type])
  @@map("fin_recurrences")
}

/// Metadados de assinatura sobre uma recorrência de despesa.
model Subscription {
  id           String             @id @default(uuid(7)) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  recurrenceId String             @unique @map("recurrence_id") @db.Uuid
  name         String
  provider     String?
  website      String?
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime?          @map("started_at") @db.Date
  trialEndsAt  DateTime?          @map("trial_ends_at") @db.Date
  canceledAt   DateTime?          @map("canceled_at") @db.Date
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recurrence Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: NoAction)

  @@index([workspaceId, status])
  @@map("fin_subscriptions")
}

/// Dados da venda. O valor, a previsão, a data de recebimento e o status
/// vivem no Transaction (receita a receber) — fonte única para o fluxo de caixa.
model Commission {
  id                 String    @id @default(uuid(7)) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  transactionId      String    @unique @map("transaction_id") @db.Uuid
  clientName         String    @map("client_name")
  /// Vendedor que recebe a comissão (a empresa paga: é uma despesa).
  sellerName         String    @default("") @map("seller_name")
  saleDescription    String    @map("sale_description")
  saleAmount         Decimal   @map("sale_amount") @db.Decimal(14, 2)
  ratePercent        Decimal   @map("rate_percent") @db.Decimal(7, 4)
  /// true quando o valor foi digitado em vez de calculado (venda × %).
  isAmountOverridden Boolean   @default(false) @map("is_amount_overridden")
  saleDate           DateTime  @map("sale_date") @db.Date
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: NoAction)
  attachments Attachment[]

  @@index([workspaceId, saleDate])
  @@index([workspaceId, clientName])
  @@map("fin_commissions")
}

// Cartões, faturas e compras parceladas.

/// Limite disponível = limite − compras/parcelas ainda não pagas (calculado).
model CreditCard {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  name             String
  issuer           String
  brand            CardBrand
  lastFour         String?   @map("last_four") @db.Char(4)
  creditLimit      Decimal   @map("credit_limit") @db.Decimal(14, 2)
  closingDay       Int       @map("closing_day")
  dueDay           Int       @map("due_day")
  /// Conta usada por padrão para pagar a fatura.
  paymentAccountId String?   @map("payment_account_id") @db.Uuid
  color            String?   @db.VarChar(7)
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentAccount   Account?            @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  invoices         CreditCardInvoice[]
  transactions     Transaction[]
  recurrences      Recurrence[]
  installmentPlans InstallmentPlan[]
  importBatches    ImportBatch[]

  @@unique([workspaceId, name])
  @@map("fin_credit_cards")
}

/// Datas gravadas na fatura: mudar o dia de fechamento do cartão
/// só afeta faturas futuras.
model CreditCardInvoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  creditCardId    String        @map("credit_card_id") @db.Uuid
  /// 1º dia do mês de vencimento ("fatura de outubro" vence em outubro).
  referenceMonth  DateTime      @map("reference_month") @db.Date
  closingDate     DateTime      @map("closing_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(OPEN)
  /// Valor que o banco cobrou (conciliação com a soma dos itens).
  statementAmount Decimal?      @map("statement_amount") @db.Decimal(14, 2)
  closedAt        DateTime?     @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: NoAction)
  transactions Transaction[]
  attachments  Attachment[]

  @@unique([creditCardId, referenceMonth])
  @@index([workspaceId, dueDate])
  @@map("fin_credit_card_invoices")
}

/// Compra parcelada (cartão, boleto, carnê, crediário). Cada parcela é um
/// Transaction com installmentNumber.
model InstallmentPlan {
  id               String                @id @default(uuid(7)) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  description      String
  merchant         String?
  categoryId       String?               @map("category_id") @db.Uuid
  /// Valor total parcelado (com juros, se houver).
  totalAmount      Decimal               @map("total_amount") @db.Decimal(14, 2)
  /// Preço à vista, para mostrar os juros embutidos.
  cashPrice        Decimal?              @map("cash_price") @db.Decimal(14, 2)
  installmentCount Int                   @map("installment_count")
  /// Parcelas já pagas antes de o sistema ser usado (não geram lançamentos).
  priorPaidCount   Int                   @default(0) @map("prior_paid_count")
  purchaseDate     DateTime              @map("purchase_date") @db.Date
  firstDueDate     DateTime              @map("first_due_date") @db.Date
  creditCardId     String?               @map("credit_card_id") @db.Uuid
  accountId        String?               @map("account_id") @db.Uuid
  paymentMethod    PaymentMethod?        @map("payment_method")
  status           InstallmentPlanStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: NoAction)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: NoAction)
  installments Transaction[]
  asset        Asset?
  liability    Liability?
  attachments  Attachment[]

  @@index([workspaceId, status])
  @@map("fin_installment_plans")
}

// Planejamento: orçamento e metas.

/// Limite mensal por categoria, com vigência: mudar o limite a partir de
/// novembro não reescreve outubro.
model Budget {
  id                    String    @id @default(uuid(7)) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  categoryId            String    @map("category_id") @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  /// 1º dia do mês inicial.
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  /// 1º dia do último mês (inclusive); null = vigente.
  effectiveTo           DateTime? @map("effective_to") @db.Date
  alertThresholdPercent Int       @default(80) @map("alert_threshold_percent")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  @@unique([categoryId, effectiveFrom])
  @@index([workspaceId])
  @@map("fin_budgets")
}

/// Valor atual = saldo da conta vinculada OU valor inicial + aportes.
model Goal {
  id              String     @id @default(uuid(7)) @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  name            String
  kind            GoalKind
  targetAmount    Decimal    @map("target_amount") @db.Decimal(14, 2)
  initialAmount   Decimal    @default(0) @map("initial_amount") @db.Decimal(14, 2)
  targetDate      DateTime?  @map("target_date") @db.Date
  linkedAccountId String?    @map("linked_account_id") @db.Uuid
  status          GoalStatus @default(ACTIVE)
  achievedAt      DateTime?  @map("achieved_at") @db.Date
  icon            String?
  color           String?    @db.VarChar(7)
  sortOrder       Int        @default(0) @map("sort_order")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedAccount Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([workspaceId, status])
  @@map("fin_goals")
}

/// Aporte (positivo) ou resgate (negativo — única exceção à regra do valor
/// positivo, protegida por CHECK amount <> 0).
model GoalContribution {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @db.Date
  /// Transferência que materializou o aporte, se houver.
  transactionId String?  @unique @map("transaction_id") @db.Uuid
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@map("fin_goal_contributions")
}

// Patrimônio: bens, dívidas e fotografias periódicas.

/// Bens fora das contas (equipamentos, veículos, investimentos avaliados à mão).
model Asset {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  name              String
  kind              AssetKind
  acquisitionDate   DateTime? @map("acquisition_date") @db.Date
  acquisitionValue  Decimal?  @map("acquisition_value") @db.Decimal(14, 2)
  currentValue      Decimal   @map("current_value") @db.Decimal(14, 2)
  valuedAt          DateTime  @map("valued_at") @db.Date
  /// Bem comprado parcelado (ex.: FX30): ativo e dívida ficam ligados.
  installmentPlanId String?   @unique @map("installment_plan_id") @db.Uuid
  notes             String?
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  valuations      AssetValuation[]
  attachments     Attachment[]

  @@index([workspaceId, kind])
  @@map("fin_assets")
}

model AssetValuation {
  id        String   @id @default(uuid(7)) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  date      DateTime @db.Date
  value     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@map("fin_asset_valuations")
}

/// Dívidas fora do cartão. Se ligada a um InstallmentPlan, o saldo devedor é
/// calculado das parcelas; senão, usa currentBalance informado.
/// Cartões e parcelas no cartão NÃO são duplicados aqui.
model Liability {
  id                  String        @id @default(uuid(7)) @db.Uuid
  workspaceId         String        @map("workspace_id") @db.Uuid
  name                String
  kind                LiabilityKind
  creditor            String?
  originalAmount      Decimal       @map("original_amount") @db.Decimal(14, 2)
  currentBalance      Decimal?      @map("current_balance") @db.Decimal(14, 2)
  balanceUpdatedAt    DateTime?     @map("balance_updated_at") @db.Date
  monthlyInterestRate Decimal?      @map("monthly_interest_rate") @db.Decimal(7, 4)
  startDate           DateTime      @map("start_date") @db.Date
  endDate             DateTime?     @map("end_date") @db.Date
  installmentPlanId   String?       @unique @map("installment_plan_id") @db.Uuid
  notes               String?
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind])
  @@map("fin_liabilities")
}

/// Fotografia periódica (diária/mensal) para histórico de patrimônio e
/// gráficos rápidos. Gerada por job idempotente.
model FinancialSnapshot {
  id               String         @id @default(uuid(7)) @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  period           SnapshotPeriod
  /// Último dia do período.
  date             DateTime       @db.Date
  liquidBalance    Decimal        @map("liquid_balance") @db.Decimal(14, 2)
  investedBalance  Decimal        @map("invested_balance") @db.Decimal(14, 2)
  totalAssets      Decimal        @map("total_assets") @db.Decimal(14, 2)
  totalLiabilities Decimal        @map("total_liabilities") @db.Decimal(14, 2)
  netWorth         Decimal        @map("net_worth") @db.Decimal(14, 2)
  incomeTotal      Decimal        @map("income_total") @db.Decimal(14, 2)
  expenseTotal     Decimal        @map("expense_total") @db.Decimal(14, 2)
  /// Quebras por conta, categoria e cartão (formato versionado).
  breakdown        Json           @default("{}")
  schemaVersion    Int            @default(1) @map("schema_version")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, date])
  @@map("fin_financial_snapshots")
}

// Sistema: anexos, alertas, importação, auditoria e jobs.

/// Arquivo fora de /public, servido por rota autenticada.
/// Exatamente um dono (CHECK no banco).
model Attachment {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  fileName          String    @map("file_name")
  mimeType          String    @map("mime_type")
  sizeBytes         Int       @map("size_bytes")
  /// Caminho no provedor de armazenamento (local hoje; S3/Supabase amanhã).
  storageKey        String    @unique @map("storage_key")
  checksumSha256    String    @map("checksum_sha256") @db.Char(64)
  transactionId     String?   @map("transaction_id") @db.Uuid
  installmentPlanId String?   @map("installment_plan_id") @db.Uuid
  commissionId      String?   @map("commission_id") @db.Uuid
  invoiceId         String?   @map("invoice_id") @db.Uuid
  assetId           String?   @map("asset_id") @db.Uuid
  uploadedById      String?   @map("uploaded_by_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction     Transaction?       @relation(fields: [transactionId], references: [id], onDelete: NoAction)
  installmentPlan InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id], onDelete: NoAction)
  commission      Commission?        @relation(fields: [commissionId], references: [id], onDelete: NoAction)
  invoice         CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: NoAction)
  asset           Asset?             @relation(fields: [assetId], references: [id], onDelete: NoAction)
  uploadedBy      User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([installmentPlanId])
  @@index([commissionId])
  @@index([invoiceId])
  @@index([assetId])
  @@map("fin_attachments")
}

/// Alerta gerado pelo motor de regras. `dedupeKey` torna a geração idempotente
/// (ex.: "bill_due:1:<transactionId>").
model Notification {
  id           String               @id @default(uuid(7)) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  /// null = todos os membros do workspace.
  userId       String?              @map("user_id")
  /// Código da regra, ex.: "bill.due_soon", "budget.threshold".
  code         String
  priority     NotificationPriority
  title        String
  body         String
  href         String?
  entityType   String?              @map("entity_type")
  entityId     String?              @map("entity_id")
  dedupeKey    String               @map("dedupe_key")
  readAt       DateTime?            @map("read_at") @db.Timestamptz(3)
  dismissedAt  DateTime?            @map("dismissed_at") @db.Timestamptz(3)
  snoozedUntil DateTime?            @map("snoozed_until") @db.Timestamptz(3)
  /// Depois disso o alerta deixa de fazer sentido (ex.: conta já venceu e foi paga).
  validUntil   DateTime?            @map("valid_until") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, dismissedAt, priority])
  @@map("fin_notifications")
}

model ImportBatch {
  id           String       @id @default(uuid(7)) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  source       ImportSource
  fileName     String?      @map("file_name")
  accountId    String?      @map("account_id") @db.Uuid
  creditCardId String?      @map("credit_card_id") @db.Uuid
  status       ImportStatus @default(DRAFT)
  /// Linhas lidas, novas, duplicadas, ignoradas.
  stats        Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt  DateTime?    @map("committed_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: NoAction)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: NoAction)
  transactions Transaction[]

  @@index([workspaceId, createdAt])
  @@map("fin_import_batches")
}

/// Trilha de auditoria append-only (quem mudou o quê, antes/depois).
model FinAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id")
  /// Ex.: "transaction.update", "backup.restore", "auth.login".
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  /// { before, after } apenas dos campos alterados.
  changes     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("fin_audit_logs")
}

/// Execuções de jobs (recorrências, alertas, snapshots, backup).
/// (name, runKey) único → cada job roda uma vez por período, mesmo que o
/// gatilho dispare várias vezes.
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  runKey     String    @map("run_key")
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  error      String?
  details    Json?

  @@unique([name, runKey])
  @@map("fin_job_runs")
}

/// Fechamento mensal: registro do ritual de conferência com os totais congelados no dia.
model MonthClose {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Mês fechado, "2026-09".
  month       String   @db.Char(7)
  closedAt    DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  closedById  String?  @map("closed_by_id")
  notes       String?
  /// Receitas, despesas, resultado, patrimônio e maior categoria no momento do fechamento.
  summary     Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
  @@map("fin_month_closes")
}
