# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm_clientes?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/crm_clientes?schema=public"

# JWT
JWT_SECRET="sua-chave-secreta-jwt-minimo-32-caracteres"
JWT_EXPIRES_IN="7d"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Agente de IA no WhatsApp (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# WhatsApp Bridge — conector temporário via QR Code (whatsapp-bridge/), enquanto
# a API oficial da Meta não está pronta. Gere um valor aleatório e use o mesmo
# valor no .env do whatsapp-bridge/.
WHATSAPP_BRIDGE_SECRET="gere-um-valor-aleatorio-longo"
