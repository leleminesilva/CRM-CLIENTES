# URL do CRM em produção (sem barra no final)
CRM_BASE_URL=https://crm-clientes-leleminesilvas-projects.vercel.app

# Mesmo valor da variável WHATSAPP_BRIDGE_SECRET configurada na Vercel
WHATSAPP_BRIDGE_SECRET=

# Opcional — nome que aparece pra você identificar essa conexão
NOME_INSTANCIA=WhatsApp (QR temporário)

# Opcional — pra conectar MAIS DE UM número ao mesmo tempo, rode uma cópia deste
# script por número, cada uma com um valor diferente de INSTANCIA (ex: "comercial",
# "suporte"). Pode setar aqui no .env ou passar na hora de rodar:
#   INSTANCIA=comercial npm start
INSTANCIA=padrao
