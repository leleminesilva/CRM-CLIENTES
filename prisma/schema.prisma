generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMINISTRADOR
  DESENVOLVEDOR
  GESTOR
  COMERCIAL
  OPERACIONAL
}

enum Porte {
  MICRO
  PEQUENO
  MEDIO
  GRANDE
  ENTERPRISE
}

enum OrigemCliente {
  INDICACAO
  SITE
  REDES_SOCIAIS
  GOOGLE_ADS
  EVENTO
  LIGACAO_ATIVA
  PARCEIRO
  WHATSAPP
  OUTROS
}

enum EstagioLead {
  NOVO_LEAD
  CONTATO_INICIAL
  PRIMEIRO_ORCAMENTO
  QUALIFICACAO
  PROPOSTA_ENVIADA
  NEGOCIACAO
  FECHADO_GANHO
  FECHADO_PERDIDO
  REENGAJAR
}

enum Temperatura {
  QUENTE
  MORNO
  FRIO
}

enum StatusOportunidade {
  ABERTA
  GANHA
  PERDIDA
  SUSPENSA
}

enum TipoTarefa {
  REUNIAO
  LIGACAO
  VISITA
  FOLLOW_UP
  EMAIL
  TAREFA
  NOTIFICACAO
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  ATRASADA
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum TipoAtividade {
  CRIACAO
  EDICAO
  ESTAGIO_ALTERADO
  COMENTARIO
  TAREFA_CRIADA
  TAREFA_CONCLUIDA
  LIGACAO
  EMAIL
  REUNIAO
  ANEXO_ADICIONADO
}

enum TipoNotificacao {
  LEAD_NOVO
  TAREFA_VENCENDO
  OPORTUNIDADE_PARADA
  CLIENTE_SEM_CONTATO
  ORCAMENTO_PENDENTE
  SISTEMA
  WHATSAPP_MENSAGEM
}

enum StatusOrcamentoCliente {
  PENDENTE
  APROVADO
  NAO_APROVADO
}

enum ModoCalculoProduto {
  AREA
  LINEAR
  UNIDADE
}

enum StatusOrcamentoTecnico {
  RASCUNHO
  ENVIADO
  APROVADO
  REPROVADO
}

enum StatusOrdemServico {
  EM_PRODUCAO
  CONCLUIDO
  CANCELADO
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String    @id @default(cuid())
  nome      String
  email     String    @unique
  senha     String
  role      Role      @default(COMERCIAL)
  avatar    String?
  ativo     Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  prefsNotificacao Json?

  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  tarefas       Tarefa[]
  atividades    Atividade[]
  comentarios   Comentario[]
  notificacoes  Notificacao[]
  auditLogs     AuditLog[]

  chatMensagensEnviadas  ChatMensagem[]   @relation("ChatMensagensEnviadas")
  chatMensagensRecebidas ChatMensagem[]   @relation("ChatMensagensRecebidas")
  chatLeitura            ChatLeitura?
  alertasRecebidos       Alerta[]         @relation("AlertasRecebidos")
  alertasCriados         Alerta[]         @relation("AlertasCriados")
  alertasLeituras        AlertaLeitura[]
  whatsappSessoes        WhatsAppSessao[] @relation("WhatsAppAtendente")

  orcamentosTecnicosResponsavel OrcamentoTecnico[] @relation("OrcamentoTecnicoResponsavel")
  ordensServicoVendedor         OrdemServico[]     @relation("OrdemServicoVendedor")

  @@map("users")
}

model Empresa {
  id           String    @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?   @unique
  segmento     String?
  porte        Porte     @default(PEQUENO)
  website      String?
  telefone     String?
  email        String?
  cep          String?
  logradouro   String?
  numero       String?
  bairro       String?
  cidade       String?
  estado       String?
  observacoes  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contatos      Contato[]
  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  atividades    Atividade[]

  @@map("empresas")
}

model Contato {
  id          String    @id @default(cuid())
  nome        String
  cargo       String?
  email       String?
  telefone    String?
  whatsapp    String?
  cpf         String?
  avatar      String?
  principal   Boolean   @default(false)
  observacoes String?
  empresaId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  clientes      Cliente[]
  leads         Lead[]
  oportunidades Oportunidade[]
  atividades    Atividade[]
  comentarios   Comentario[]

  @@map("contatos")
}

model Cliente {
  id                   String                 @id @default(cuid())
  nome                 String
  razaoSocial          String?
  nomeFantasia         String?
  cpfCnpj              String?
  telefone             String?
  whatsapp             String?
  email                String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  tipoResidencia       String?
  bairro               String?
  cidade               String?
  estado               String?
  segmento             String?
  porte                Porte?
  origem               OrigemCliente          @default(OUTROS)
  responsavelId        String?
  empresaId            String?
  contatoId            String?
  observacoes          String?
  // Campos do fluxo de atendimento
  dataInscricao        DateTime?
  servicoBuscado       String?
  numeroOrcamento      String?
  valorOrcamento       Decimal?               @db.Decimal(15, 2)
  prazoOrcamento       DateTime?
  dataVenda            DateTime?
  statusOrcamento      StatusOrcamentoCliente @default(PENDENTE)
  orcamentoEnviadoEm   DateTime?
  orcamentoFinalNumero String?
  orcamentoFinalValor  Decimal?               @db.Decimal(15, 2)
  orcamentoFinalEm     DateTime?
  revisadoEm           DateTime?
  notificacaoMensagem  String?
  notificacaoEm        DateTime?
  notificacaoLida      Boolean                @default(false)
  temperatura          Temperatura            @default(MORNO)
  motivoExclusao       String?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  responsavel        User?              @relation(fields: [responsavelId], references: [id])
  empresa            Empresa?           @relation(fields: [empresaId], references: [id])
  contato            Contato?           @relation(fields: [contatoId], references: [id])
  leads              Lead[]
  oportunidades      Oportunidade[]
  tarefas            Tarefa[]
  atividades         Atividade[]
  comentarios        Comentario[]
  anexos             Anexo[]
  orcamentosTecnicos OrcamentoTecnico[]

  @@map("clientes")
}

model Lead {
  id             String        @id @default(cuid())
  titulo         String
  descricao      String?
  estagio        EstagioLead   @default(NOVO_LEAD)
  ordemKanban    Int           @default(0)
  valorEstimado  Decimal?      @db.Decimal(15, 2)
  temperatura    Temperatura   @default(MORNO)
  origem         OrigemCliente @default(OUTROS)
  responsavelId  String?
  clienteId      String?
  empresaId      String?
  contatoId      String?
  dataFechamento DateTime?
  motivoPerda    String?
  proximoContato DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  responsavel   User?          @relation(fields: [responsavelId], references: [id])
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  contato       Contato?       @relation(fields: [contatoId], references: [id])
  oportunidades Oportunidade[]
  tarefas       Tarefa[]
  atividades    Atividade[]
  comentarios   Comentario[]
  anexos        Anexo[]

  @@map("leads")
}

model Oportunidade {
  id             String             @id @default(cuid())
  titulo         String
  descricao      String?
  valor          Decimal            @db.Decimal(15, 2)
  probabilidade  Int                @default(50)
  status         StatusOportunidade @default(ABERTA)
  dataPrevisao   DateTime?
  dataFechamento DateTime?
  responsavelId  String?
  clienteId      String?
  empresaId      String?
  contatoId      String?
  leadId         String?
  motivoPerda    String?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  responsavel User?        @relation(fields: [responsavelId], references: [id])
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  empresa     Empresa?     @relation(fields: [empresaId], references: [id])
  contato     Contato?     @relation(fields: [contatoId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  tarefas     Tarefa[]
  atividades  Atividade[]
  comentarios Comentario[]
  anexos      Anexo[]

  @@map("oportunidades")
}

model Tarefa {
  id             String       @id @default(cuid())
  titulo         String
  descricao      String?
  tipo           TipoTarefa   @default(TAREFA)
  status         StatusTarefa @default(PENDENTE)
  prioridade     Prioridade   @default(MEDIA)
  dataVencimento DateTime
  horario        String?
  dataInicio     DateTime?
  dataConclusao  DateTime?
  responsavelId  String?
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  responsavel  User?         @relation(fields: [responsavelId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  atividades   Atividade[]

  @@map("tarefas")
}

model Atividade {
  id             String        @id @default(cuid())
  tipo           TipoAtividade
  descricao      String
  userId         String
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  contatoId      String?
  empresaId      String?
  tarefaId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  contato      Contato?      @relation(fields: [contatoId], references: [id])
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  tarefa       Tarefa?       @relation(fields: [tarefaId], references: [id])

  @@map("atividades")
}

model Comentario {
  id             String    @id @default(cuid())
  texto          String
  userId         String
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  contatoId      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  contato      Contato?      @relation(fields: [contatoId], references: [id])

  @@map("comentarios")
}

model Anexo {
  id             String    @id @default(cuid())
  nome           String
  url            String
  tipo           String
  tamanho        Int
  clienteId      String?
  leadId         String?
  oportunidadeId String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])

  @@map("anexos")
}

model Notificacao {
  id        String          @id @default(cuid())
  titulo    String
  mensagem  String
  tipo      TipoNotificacao
  lida      Boolean         @default(false)
  userId    String
  linkUrl   String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notificacoes")
}

// ==========================================
// CHAT INTERNO (comunicação entre a equipe)
// ==========================================

model ChatMensagem {
  id             String    @id @default(cuid())
  conteudo       String
  autorId        String
  // null = mensagem do canal geral (visível a todos); preenchido = DM pro usuário
  destinatarioId String?
  lida           Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  autor        User  @relation("ChatMensagensEnviadas", fields: [autorId], references: [id])
  destinatario User? @relation("ChatMensagensRecebidas", fields: [destinatarioId], references: [id])

  @@index([destinatarioId])
  @@index([autorId])
  @@index([createdAt])
  @@map("chat_mensagens")
}

// Marca até quando cada usuário já leu o canal geral — usado só pra contar não lidas
// (mensagens diretas já têm o campo "lida" por mensagem, isso aqui é só pro canal geral).
model ChatLeitura {
  id          String   @id @default(cuid())
  userId      String   @unique
  ultimaGeral DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("chat_leituras")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  entidade     String
  entidadeId   String
  acao         String
  dadosAntigos Json?
  dadosNovos   Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// WHATSAPP — gateway self-hosted (Evolution API), ver docs/architecture/whatsapp.md
// ==========================================

enum WhatsAppProvider {
  EVOLUTION
  META
  WPPCONNECT
  GREEN_API
  UNKNOWN
}

enum WhatsAppSessaoStatus {
  ONLINE
  OFFLINE
  RECONNECTING
  WAITING_QR
  ERROR
  UNKNOWN
}

enum WhatsAppSessaoEvento {
  CONECTOU
  DESCONECTOU
  QR_GERADO
  QR_EXPIROU
  ERRO
  RECONECTOU
  REINICIOU
  ATUALIZOU
}

enum WhatsAppMensagemStatus {
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

model WhatsAppSessao {
  id                     String               @id @default(cuid())
  nome                   String
  numero                 String?
  provider               WhatsAppProvider     @default(EVOLUTION)
  providerVersion        String?
  providerSessionId      String               @unique
  status                 WhatsAppSessaoStatus @default(UNKNOWN)
  ultimoPing             DateTime?
  ultimaMensagemRecebida DateTime?
  lastError              String?
  lastErrorAt            DateTime?
  atendenteId            String?
  empresaId              String?
  ativo                  Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  atendente User?               @relation("WhatsAppAtendente", fields: [atendenteId], references: [id])
  conversas WhatsAppConversa[]
  logs      WhatsAppSessaoLog[]

  @@index([atendenteId])
  @@map("whatsapp_sessoes")
}

model WhatsAppSessaoLog {
  id        String               @id @default(cuid())
  sessaoId  String
  evento    WhatsAppSessaoEvento
  detalhe   String?
  createdAt DateTime             @default(now())

  sessao WhatsAppSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@map("whatsapp_sessao_logs")
}

// Dedup de entrega de webhook (idempotência) — ver docs/architecture/whatsapp.md
model WhatsAppWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  tipo            String
  recebidoEm      DateTime @default(now())

  @@map("whatsapp_webhook_events")
}

model WhatsAppConversa {
  id           String    @id @default(cuid())
  sessaoId     String
  contatoPhone String
  contatoNome  String?
  clienteId    String?
  ultimaMsgEm  DateTime?
  naoLidas     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Restrict (não Cascade): excluir uma sessão nunca pode apagar histórico de
  // conversas junto — é por isso que essa arquitetura existe. "Excluir sessão"
  // na prática é soft-delete (WhatsAppSessao.ativo = false), então essa
  // restrição nunca deveria ser acionada em uso normal; existe como rede de
  // segurança contra um DELETE direto acidental na tabela de sessões.
  sessao      WhatsAppSessao       @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  mensagens   WhatsAppMensagem[]
  agentEstado WhatsAppAgentEstado?

  @@unique([sessaoId, contatoPhone])
  @@index([sessaoId])
  @@map("whatsapp_conversas")
}

model WhatsAppMensagem {
  id                String                 @id @default(cuid())
  conversaId        String
  providerMessageId String?                @unique
  direcao           String // 'entrada' | 'saida'
  tipo              String                 @default("texto")
  conteudo          String
  mediaUrl          String?
  status            WhatsAppMensagemStatus @default(ENVIANDO)
  enviadaEm         DateTime               @default(now())
  entregueEm        DateTime?
  lidaEm            DateTime?
  falhouEm          DateTime?

  conversa WhatsAppConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("whatsapp_mensagens")
}

// Estado do agente de IA de recepção — separado de WhatsAppConversa para não
// acoplar o modelo de conversa a campos específicos do agente.
model WhatsAppAgentEstado {
  id                  String         @id @default(cuid())
  conversaId          String         @unique
  estado              BotEstado      @default(TRIAGEM)
  nome                String?
  servico             String?
  cidade              String?
  urgente             Boolean        @default(false)
  resumo              String?
  tentativas          Int            @default(0)
  motivoTransferencia HandoffReason?
  agentVersion        String         @default("1.0")
  clienteId           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  conversa WhatsAppConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@map("whatsapp_agent_estados")
}

enum BotEstado {
  TRIAGEM
  COLETANDO
  AGUARDANDO_CONFIRMACAO
  CONCLUIDO
  HUMANO
}

enum HandoffReason {
  MUITAS_TENTATIVAS
  CLIENTE_PEDIU_HUMANO
  SERVICO_NAO_RECONHECIDO
}

model Alerta {
  id            String          @id @default(cuid())
  titulo        String
  mensagem      String
  criadoEm      DateTime        @default(now())
  destinoUserId String?
  destinoUser   User?           @relation("AlertasRecebidos", fields: [destinoUserId], references: [id], onDelete: Cascade)
  criadorId     String
  criador       User            @relation("AlertasCriados", fields: [criadorId], references: [id], onDelete: Cascade)
  leituras      AlertaLeitura[]

  @@map("alertas")
}

model AlertaLeitura {
  id       String   @id @default(cuid())
  alertaId String
  alerta   Alerta   @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lidoEm   DateTime @default(now())

  @@unique([alertaId, userId])
  @@map("alertas_leituras")
}

// ==========================================
// ORÇAMENTOS TÉCNICOS — motor de orçamento por vão/vidro, ordens de serviço e
// sobras de material (segmento serralheria/vidraçaria). Restrito ao cargo
// DESENVOLVEDOR, ver docs/architecture/orcamentos-tecnicos.md.
// ==========================================

model LinhaProduto {
  id        String    @id @default(cuid())
  nome      String    @unique
  ordem     Int       @default(0)
  ativo     Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  produtos ProdutoCatalogo[]

  @@map("linhas_produto")
}

model ProdutoCatalogo {
  id          String             @id @default(cuid())
  linhaId     String
  nome        String
  modoCalculo ModoCalculoProduto
  // usado só quando o produto não tem nenhuma VarianteProduto ativa
  precoBase   Decimal            @default(0) @db.Decimal(15, 2)
  imagemUrl   String?
  ordem       Int                @default(0)
  ativo       Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  linha     LinhaProduto           @relation(fields: [linhaId], references: [id])
  variantes VarianteProduto[]
  itens     ItemOrcamentoTecnico[]

  @@unique([linhaId, nome])
  @@index([linhaId])
  @@map("produtos_catalogo")
}

// Cada linha é um SKU já combinado (ex.: "6mm Temperado Liso"), com preço
// próprio — não uma faceta somável com outras. Um item escolhe no máximo uma.
model VarianteProduto {
  id            String    @id @default(cuid())
  produtoId     String
  nome          String
  // rótulo de agrupamento/exibição opcional (ex. "ESPESSURA", "COR") — não
  // participa do cálculo, é só pra organizar a UI de seleção.
  categoria     String?
  precoUnitario Decimal   @default(0) @db.Decimal(15, 2)
  ordem         Int       @default(0)
  ativo         Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  produto ProdutoCatalogo        @relation(fields: [produtoId], references: [id])
  itens   ItemOrcamentoTecnico[]

  @@unique([produtoId, nome])
  @@index([produtoId])
  @@map("variantes_produto")
}

model OrcamentoTecnico {
  id                 String                 @id @default(cuid())
  numero             Int                    @unique @default(autoincrement())
  clienteId          String?
  responsavelId      String?
  bairroInstalacao   String?
  enderecoInstalacao String?
  observacoes        String?
  status             StatusOrcamentoTecnico @default(RASCUNHO)
  descontoPercentual Decimal?               @db.Decimal(5, 2)
  descontoValor      Decimal?               @db.Decimal(15, 2)
  // subtotal/valorTotal são denormalizados e recalculados no servidor a cada
  // mutação de itens — evita somar itens toda vez que a lista é exibida.
  subtotal           Decimal                @default(0) @db.Decimal(15, 2)
  valorTotal         Decimal                @default(0) @db.Decimal(15, 2)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  cliente      Cliente?               @relation(fields: [clienteId], references: [id])
  responsavel  User?                  @relation("OrcamentoTecnicoResponsavel", fields: [responsavelId], references: [id])
  itens        ItemOrcamentoTecnico[]
  ordemServico OrdemServico?
  sobras       SobraMaterial[]

  @@index([status])
  @@index([clienteId])
  @@map("orcamentos_tecnicos")
}

model ItemOrcamentoTecnico {
  id                 String   @id @default(cuid())
  orcamentoId        String
  produtoId          String
  varianteId         String?
  // só os campos relevantes ao modoCalculo do produto são preenchidos
  larguraMm          Int?
  alturaMm           Int?
  comprimentoMm      Int?
  quantidade         Int      @default(1)
  ambienteInstalacao String?
  descricao          String?
  // preço já aplicado à dimensão (m²/m) ou preço fixo — ANTES de acréscimo e
  // quantidade. Congelado no momento do cálculo: não é reprecificado depois
  // se o catálogo mudar (mesma lógica de uma nota já emitida).
  precoCalculado     Decimal  @db.Decimal(15, 2)
  acrescimoValor     Decimal  @default(0) @db.Decimal(15, 2)
  // (precoCalculado * quantidade) + acrescimoValor
  totalItem          Decimal  @db.Decimal(15, 2)
  ordem              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orcamento     OrcamentoTecnico @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto       ProdutoCatalogo  @relation(fields: [produtoId], references: [id])
  variante      VarianteProduto? @relation(fields: [varianteId], references: [id])
  sobrasGeradas SobraMaterial[]  @relation("SobraUsadaEmItem")

  @@index([orcamentoId])
  @@index([produtoId])
  @@map("itens_orcamento_tecnico")
}

model OrdemServico {
  id              String             @id @default(cuid())
  orcamentoId     String             @unique
  vendedorId      String?
  previsaoEntrega DateTime
  progresso       Int                @default(0)
  status          StatusOrdemServico @default(EM_PRODUCAO)
  concluidoEm     DateTime?
  canceladoEm     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  orcamento OrcamentoTecnico @relation(fields: [orcamentoId], references: [id])
  vendedor  User?            @relation("OrdemServicoVendedor", fields: [vendedorId], references: [id])

  @@index([status])
  @@index([previsaoEntrega])
  @@map("ordens_servico")
}

// Reaproveitamento manual de sobras de perfil de alumínio ou retalho de
// vidro. Sem otimização de corte nesta versão — só cadastro e marcação de uso.
model SobraMaterial {
  id                String    @id @default(cuid())
  tipo              String
  descricao         String?
  larguraMm         Int?
  alturaMm          Int?
  comprimentoMm     Int?
  origemOrcamentoId String?
  disponivel        Boolean   @default(true)
  usadoEmItemId     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  origemOrcamento OrcamentoTecnico?     @relation(fields: [origemOrcamentoId], references: [id])
  usadoEmItem     ItemOrcamentoTecnico? @relation("SobraUsadaEmItem", fields: [usadoEmItemId], references: [id])

  @@index([disponivel])
  @@map("sobras_material")
}
